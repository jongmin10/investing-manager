generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Phase 1: 경제지표 시계열 데이터
model IndicatorRecord {
  id         String   @id @default(cuid())
  type       String   // BOK_BASE_RATE, GOV_BOND_3Y, GOV_BOND_10Y, KOSPI, KOSDAQ,
                      // SP500, CPI, PPI, KRW_USD, CLI, UNEMPLOYMENT, VIX
  value      Float
  recordedAt DateTime

  @@index([type, recordedAt])
}

// Phase 2: 사용자 (NextAuth 연동 예정)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskProfile   RiskProfile?
  alertSettings AlertSetting[]
}

// Phase 2: 투자자 성향 설문 결과
model RiskProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskType  String   // CONSERVATIVE | MODERATE_CONSERVATIVE | MODERATE | AGGRESSIVE | VERY_AGGRESSIVE
  answers   String   // JSON: 설문 답변 배열
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 3: 지표 알림 설정
model AlertSetting {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicatorType String
  threshold     Float
  direction     String   // ABOVE | BELOW
  channel       String   // PUSH | EMAIL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
