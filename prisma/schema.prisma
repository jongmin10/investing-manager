generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 투자전략 플래너: ETF 누적수익률 (H5/L — 코드 상수 E → DB 이전)
// - key: 코드 상수 E의 식별자(예: "KOSPI200","SP500","NASDAQ100","국채3년" 등). ETF_DEFS에서 참조.
// - cumulativeReturn/returnYears/returnPeriod: 기존 상수값과 1:1 동일. 누적 비교 금지, CAGR로만 상호비교.
// - source/asOf: 값의 출처와 기준일(검증/표시용).
// - updateMethod: INDEX_CAGR(지수 수집으로 자동 갱신 가능) | MANUAL(지수 미수집·수동 시드 관리).
// - indexType: INDEX_CAGR일 때 CAGR 산출에 쓰는 IndicatorRecord.type(예: "KOSPI","SP500","NASDAQ100"). MANUAL이면 null.
model EtfReturn {
  id               String   @id @default(cuid())
  key              String   @unique  // 상수 E 식별자 (ETF_DEFS 매핑 키)
  ticker           String              // 대표 ETF 티커 (표시용)
  name             String              // 대표 ETF 명 (표시용)
  cumulativeReturn Float               // 누적 수익률 (%)
  returnYears      Float               // 측정 기간 (년) — CAGR 산출 분모
  returnPeriod     String              // 노출용 기간 표기 (예: "10년", "6년 (설정이후)")
  source           String              // 값 출처 설명
  asOf             DateTime            // 기준일
  updateMethod     String   @default("MANUAL") // INDEX_CAGR | MANUAL
  indexType        String?             // INDEX_CAGR 시 참조할 IndicatorRecord.type
  updatedAt        DateTime @updatedAt

  @@index([updateMethod])
}

// Phase 1: 경제지표 시계열 데이터
model IndicatorRecord {
  id         String   @id @default(cuid())
  type       String   // BOK_BASE_RATE, GOV_BOND_3Y, GOV_BOND_10Y, KOSPI, KOSDAQ,
                      // SP500, CPI, PPI, KRW_USD, CLI, UNEMPLOYMENT, VIX
  value      Float
  recordedAt DateTime

  @@index([type, recordedAt])
}

// Phase 2: 사용자 (NextAuth 연동)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  riskProfile       RiskProfile?
  alertSettings     AlertSetting[]
  alertHistories    AlertHistory[]
  favoriteEvents    FavoriteEvent[]
  portfolioHoldings PortfolioHolding[]
  journalEntries    JournalEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Phase 2: 투자자 성향 설문 결과
model RiskProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskType  String   // CONSERVATIVE | MODERATE_CONSERVATIVE | MODERATE | AGGRESSIVE | VERY_AGGRESSIVE
  answers   String   // JSON: 설문 답변 배열
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 3: 지표 알림 설정
model AlertSetting {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicatorType String
  threshold     Float
  direction     String   // ABOVE | BELOW
  channel       String   // PUSH | EMAIL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Phase 3: 알림 발송 이력
model AlertHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicatorType String
  value         Float
  threshold     Float
  direction     String   // ABOVE | BELOW
  channel       String   // PUSH | EMAIL
  sentAt        DateTime @default(now())
}

// Phase 3: 경제 캘린더 즐겨찾기
model FavoriteEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
}

// Phase 3: 수익률 트래커 보유 펀드
model PortfolioHolding {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundName     String
  assetClass   String   // GUARANTEED | BOND | MIXED | EQUITY
  weight       Float
  purchaseDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 스크리너: 종목 마스터
model Stock {
  id          String           @id        // 종목코드 6자리 (e.g. "005930")
  name        String                      // 종목명
  market      String                      // "KOSPI" | "KOSDAQ"
  sector      String?                     // 업종명
  yahooSymbol String                      // Yahoo Finance 심볼 (e.g. "005930.KS")
  dartCode    String?                     // DART 고유번호 (재무데이터 수집용)
  marketCap   Float?                      // 시가총액(억) — 동적 유니버스 갱신 시 기록
  rank        Int?                        // 시총 순위 (1=최상위). 수집 대상/정렬 기준
  // Phase 3 (내부자 거래): 최근 6개월 임원·주요주주 소유보고 집계 (시점성 — elestock)
  insiderNetBuy6m  Float?                 // 6M 순매수 수량 (주, 음수=순매도) — sp_stock_lmp_irds_cnt 합
  insiderBuyCount  Int?                   // 6M 매수(증가) 보고 건수
  insiderSellCount Int?                   // 6M 매도(감소) 보고 건수
  insiderAsOf      DateTime?              // 내부자 집계 기준 시각

  snapshots  StockSnapshot[]
  financials StockFinancial[]

  @@index([rank])
}

// 스크리너: 일별 주가 스냅샷
model StockSnapshot {
  id           String   @id @default(cuid())
  stockId      String
  stock        Stock    @relation(fields: [stockId], references: [id])
  date         DateTime
  price        Float              // 현재가 (원)
  high52w      Float              // 52주 최고가
  low52w       Float              // 52주 최저가
  changeRate   Float?             // 전일 대비 등락률 (%)
  marketCap    Float?             // 시가총액 (억원)
  per          Float?
  cnsPer       Float?             // 컨센서스(추정) PER  — NAVER _cns_per
  cnsEps       Float?             // 컨센서스(추정) EPS  — NAVER _cns_eps (원)
  pbr          Float?
  dividendYield Float?            // 배당수익률 (%)       — NAVER _dvr
  volume       Float?             // 거래량
  avgVolume20d Float?             // 20일 평균 거래량

  @@unique([stockId, date])
  @@index([date])
}

// 스크리너: 재무 데이터 (DART)
model StockFinancial {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id])
  period          String   // "2024A" | "2024Q3" (연간A / 분기Q)
  revenue         Float?   // 매출액 (억원)
  operatingProfit Float?   // 영업이익 (억원)
  netIncome       Float?   // 당기순이익 (억원)
  revenueGrowth   Float?   // YoY 매출 성장률 (%)
  opGrowth        Float?   // YoY 영업이익 성장률 (%)
  netGrowth       Float?   // YoY 순이익 성장률 (%)
  opMargin        Float?   // 영업이익률 (%)
  eps             Float?   // 주당순이익 (원) — alotMatter (연결)주당순이익
  bps             Float?   // 주당순자산 (원) — 자본총계 / 발행주식수
  dps             Float?   // 주당배당금 (원) — alotMatter 보통주 현금배당금
  // Phase 2 (피터 린치 GAP 보강): 재무상태표(BS) 항목 — 억원 단위
  totalDebt       Float?   // 부채총계 (억원) — fnlttSinglAcnt BS "부채총계"
  totalEquity     Float?   // 자본총계 (억원) — fnlttSinglAcnt BS "자본총계"
  cash            Float?   // 현금및현금성자산 (억원) — fnlttSinglAcntAll BS
  // Phase 3 (자사주): 연도별 보통주 자사주 — 단위 '주' (tesstkAcqsDspsSttus 총계 행)
  treasuryAcqs    Float?   // 당기 자사주 취득수량 (주)
  treasuryDsps    Float?   // 당기 자사주 처분수량 (주)
  treasuryHeld    Float?   // 기말 자사주 보유수량 (주)

  @@unique([stockId, period])
  @@index([stockId])
}

// 투자 대가 13F
model Guru {
  id          String        @id   // "buffett" | "ackman" 등
  name        String
  fund        String
  cik         String        @unique
  description String?
  updatedAt    DateTime?
  totalAssetsM Float?   // 총자산 (백만달러) — EDGAR XBRL 10-Q/10-K
  cashM        Float?   // 현금+단기투자 (백만달러) — EDGAR XBRL
  assetsQuarter String? // 총자산 기준 분기 (예: "2025Q4")
  holdings    GuruHolding[]
}

model GuruHolding {
  id           String  @id @default(cuid())
  guruId       String
  guru         Guru    @relation(fields: [guruId], references: [id])
  quarter      String  // "2024Q4"
  cusip        String
  ticker       String?
  company      String
  shares       Float
  value        Float   // 천달러 단위 (13F 원본)
  portfolioPct Float?
  changeType   String? // "new" | "added" | "reduced" | "unchanged"
  changePct    Float?

  @@unique([guruId, quarter, cusip])
  @@index([guruId, quarter])
}

// 일일 시황 리포트
model MarketReport {
  id           String   @id @default(cuid())
  date         DateTime @unique  // 리포트 기준일 (자정 UTC)

  kospi        Float?
  kospiChange  Float?
  kosdaq       Float?
  kosdaqChange Float?
  krwUsd       Float?
  krwUsdChange Float?
  sp500        Float?
  sp500Change  Float?
  vix          Float?
  us10y        Float?
  us10yChange  Float?

  summaryKr    String?  // 한국 시황 요약 (1000자 이내)
  summaryUs    String?  // 미국 시황 요약 (1000자 이내)
  insightDcIrp String? // 퇴직연금 시사점 (150자 이내)

  status      String   @default("pending") // pending | done | failed
  generatedAt DateTime @default(now())
}

// 피터 린치 종목분석 (비동기 캐시 — ticker+snapshotDate 키)
model LynchAnalysis {
  id              String   @id @default(cuid())
  ticker          String                  // "005930"
  status          String   @default("pending") // pending | done | failed
  result          String?                 // JSON 직렬화 LynchResult
  snapshotDate    DateTime?               // 분석 시점 데이터 출처 추적
  financialPeriod String?                 // "2024A"
  model           String?
  error           String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ticker, snapshotDate])        // 데이터 기준 날짜별 캐시
  @@index([ticker])
}

// 투자 일기
model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  title        String
  body         String
  mood         String?  // "anxious" | "neutral" | "optimistic" | "confident"
  decisionType String?  // "buy" | "sell" | "rebalance" | "hold" | "analysis"
  tickers      String?  // JSON: ["OXY","AAPL"]

  // 작성 시점 시장 스냅샷
  snapshotKospi   Float?
  snapshotSp500   Float?
  snapshotKrwUsd  Float?
  snapshotUs10y   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}
