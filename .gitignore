# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# prisma sqlite db
prisma/dev.db
prisma/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# verification screenshots
/scripts/_calc-shots/
/verify-screenshots/

# claude code / local dev tooling
/.claude/
claude-dev.ps1
**/settings.local.json

# local playwright verify scripts & shots
/pw-*.mjs
/playwright-screenshots/

# playwright e2e test artifacts
/test-results/
/playwright-report/
/e2e/.auth/

# local dev server artifacts
/dev-server.log
/dev-server.pid

# local dev scratch files
/cdev.sh
/elestock_sample.json
